// Prisma sxemasi: DB jadvallari shu yerda tasvirlanadi.
// O'zgartirsangiz:  npx prisma db push

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  PENDING // navbatda, ishlanishini kutyapti
  PROCESSING // worker hozir ishlayapti
  COMPLETED // muvaffaqiyatli tugadi
  FAILED // barcha urinishlar tugadi, baribir bo'lmadi
  CANCELLED // foydalanuvchi bekor qildi
}

model Task {
  id             String     @id @default(uuid())
  type           String // masalan: "email", "report"
  payload        Json // task ma'lumotlari (jsonb)
  status         TaskStatus @default(PENDING)
  idempotencyKey String     @unique @map("idempotency_key") // bir xil key = bir xil task
  attempts       Int        @default(0) // nechta urinish bo'lgan
  lastError      String?    @map("last_error")
  runAt          DateTime   @default(now()) @map("run_at") // shu vaqtdan oldin ishlanmaydi
  startedAt      DateTime?  @map("started_at")
  completedAt    DateTime?  @map("completed_at")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  @@index([status, runAt]) // worker aynan shu bo'yicha qidiradi
  @@index([type])
  @@map("tasks")
}
